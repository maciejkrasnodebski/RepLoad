generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username        String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  templates       Template[]
  exercises       Exercise[]
  weeklyPlans     WeeklyPlan[]
  workoutSessions WorkoutSession[]

  @@map("user")
}

model Exercise {
  id              Int                      @id @default(autoincrement())
  name            String                   @unique
  description     String?
  exerciseType    String
  equipment       String?
  muscleGroup     String?
  difficultyLevel String?
  userId          String?                  @db.Uuid
  user            User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates       TemplateExercise[]
  workoutSessions WorkoutSessionExercise[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([userId])
  @@map("exercises")
}

model Template {
  id              String             @id @default(cuid())
  name            String
  dayOfWeek       Int?
  color           String?
  icon            String?
  userId          String             @db.Uuid
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises       TemplateExercise[]
  weeklyPlanDays  WeeklyPlanDay[]
  workoutSessions WorkoutSession[]
  createdAt       DateTime           @default(now())
}

model TemplateExercise {
  id              Int      @id @default(autoincrement())
  templateId      String
  exerciseId      Int
  order           Int
  sets            Int?
  reps            Int?
  weight          Float?
  durationSeconds Int?
  restSeconds     Int?
  distance        Float?
  template        Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([templateId, order])
  @@index([exerciseId])
}

model WeeklyPlan {
  id        String          @id @default(cuid())
  name      String
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  days      WeeklyPlanDay[]
  createdAt DateTime        @default(now())

  @@index([userId])
  @@map("weekly_plans")
}

enum WorkoutSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model WorkoutSession {
  id           String                   @id @default(cuid())
  userId       String                   @db.Uuid
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String?
  template     Template?                @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name         String?
  templateName String?
  status       WorkoutSessionStatus     @default(ACTIVE)
  startedAt    DateTime                 @default(now())
  endedAt      DateTime?
  exercises    WorkoutSessionExercise[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([templateId])
  @@map("workout_sessions")
}

model WorkoutSessionExercise {
  id           Int             @id @default(autoincrement())
  sessionId    String
  session      WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId   Int?
  exercise     Exercise?       @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  name         String
  exerciseType String?
  order        Int
  series       WorkoutSeries[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([sessionId, order])
  @@index([exerciseId])
  @@map("workout_session_exercises")
}

model WorkoutSeries {
  id                Int                    @id @default(autoincrement())
  sessionExerciseId Int
  sessionExercise   WorkoutSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  order             Int
  reps              Int?
  weight            Decimal?               @db.Decimal(10, 2)
  durationSeconds   Int?
  distance          Decimal?               @db.Decimal(10, 2)
  restSeconds       Int?
  rpe               Decimal?               @db.Decimal(3, 1)
  rir               Int?
  notes             String?
  isDone            Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([sessionExerciseId, order])
  @@map("workout_series")
}

model WeeklyPlanDay {
  id           Int        @id @default(autoincrement())
  weeklyPlanId String
  dayOfWeek    Int
  templateId   String?
  isRestDay    Boolean    @default(false)
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  template     Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([weeklyPlanId, dayOfWeek])
  @@index([templateId])
  @@map("weekly_plan_days")
}
